# ==========================================
# VidArch Configuration Environment File
# ==========================================

# Server Port (Default: 2498 in dev, 2499 in Docker/Production)
PORT=2499

# Environment (development | production)
NODE_ENV=production

# Storage Directories
# DATA_DIR: Stores SQLite database (vidarch.db) and cookies.txt
DATA_DIR=./data

# DOWNLOADS_DIR: Stores video archives (.mp4, .webm), thumbnails (.webp, .jpg), and metadata
DOWNLOADS_DIR=./downloads

# Custom Path to yt-dlp binary (optional, auto-detected by default)
# YT_DLP_PATH=/usr/local/bin/yt-dlp
