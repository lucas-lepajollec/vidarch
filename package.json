{
  "name": "vidarch",
  "version": "1.0.0",
  "description": "Self-hosted Video Archiver, Subscriptions Manager & Player",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "dev:demo": "npm --prefix client run dev:demo",
    "build:client": "npm --prefix client run build",
    "build:demo": "npm --prefix client run build:demo",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "test": "tsx --test server/src/utils/youtube.test.ts server/src/utils/paths.test.ts server/src/utils/innertube.test.ts server/src/utils/remoteImages.test.ts server/src/utils/ytdlpDownload.test.ts"
  },
  "keywords": [
    "youtube",
    "archiver",
    "ytdlp",
    "media-server",
    "video-player"
  ],
  "author": "Lucas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucas-lepajollec/vidarch.git"
  },
  "dependencies": {
    "@types/multer": "^2.2.0",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
